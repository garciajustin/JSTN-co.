    rel="stylesheet"
  >

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "Inter", sans-serif;
      background: #02030a;
      color: white;
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -10;
      background:
        radial-gradient(circle at 15% 20%, rgba(102,63,255,.24), transparent 28%),
        radial-gradient(circle at 85% 30%, rgba(0,210,255,.15), transparent 28%),
        radial-gradient(circle at 50% 90%, rgba(180,45,255,.16), transparent 30%),
        linear-gradient(180deg, #02030a, #050719 50%, #02030a);
    }

    .stars,
    .stars::before {
      position: fixed;
      inset: 0;
      content: "";
      pointer-events: none;
      z-index: -5;
    }

    .stars {
      background-image:
        radial-gradient(2px 2px at 10% 20%, white, transparent),
        radial-gradient(1px 1px at 30% 70%, white, transparent),
        radial-gradient(2px 2px at 80% 35%, white, transparent),
        radial-gradient(1px 1px at 65% 15%, white, transparent),
        radial-gradient(1px 1px at 90% 80%, white, transparent),
        radial-gradient(2px 2px at 45% 45%, white, transparent);

      background-size: 380px 380px;
      opacity: .6;
      animation: stars 35s linear infinite;
    }

    .stars::before {
      background-image:
        radial-gradient(1px 1px at 20% 30%, white, transparent),
        radial-gradient(1px 1px at 70% 60%, white, transparent),
        radial-gradient(1px 1px at 40% 10%, white, transparent);

      background-size: 270px 270px;
      opacity: .45;
      animation: stars 55s linear infinite reverse;
    }

    @keyframes stars {
      to {
        transform: translate(-180px, 120px);
      }
    }

    /* NAVBAR */

    .navbar {
      position: fixed;
      top: 18px;
      left: 50%;
      transform: translateX(-50%);
      width: min(1120px, 92%);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 13px 18px;
      border: 1px solid rgba(255,255,255,.11);
      border-radius: 22px;
      background: rgba(8,10,27,.65);
      backdrop-filter: blur(22px);
      box-shadow: 0 15px 60px rgba(0,0,0,.35);
      z-index: 100;
    }

    .logo {
      font: 700 1.25rem "Space Grotesk";
    }

    .logo span {
      color: #9f7cff;
    }

    .nav-links {
      display: flex;
      gap: 25px;
    }

    .nav-links a,
    .mobile-menu a {
      color: #c8c9d8;
      text-decoration: none;
      font-size: .9rem;
      transition: .25s;
    }

    .nav-links a:hover,
    .mobile-menu a:hover {
      color: white;
      text-shadow: 0 0 18px #8d6cff;
    }

    .nav-button {
      color: white;
      text-decoration: none;
      padding: 10px 15px;
      border: 1px solid rgba(255,255,255,.15);
      border-radius: 13px;
      background: rgba(255,255,255,.07);
      transition: .25s;
    }

    .nav-button:hover {
      background: rgba(255,255,255,.13);
      transform: translateY(-2px);
    }

    .menu-button {
      display: none;
      cursor: pointer;
      font-size: 1.4rem;
    }

    section {
      width: min(1120px, 90%);
      margin: auto;
    }

    /* HERO */

    .hero {
      min-height: 100vh;
      display: grid;
      place-items: center;
      text-align: center;
      padding-top: 80px;
      position: relative;
      overflow: hidden;
    }

    .hero-content {
      position: relative;
      z-index: 5;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 13px;
      border: 1px solid rgba(255,255,255,.13);
      border-radius: 999px;
      background: rgba(255,255,255,.045);
      color: #cdd0df;
      font-size: .8rem;
      margin-bottom: 25px;
    }

    .live-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #9d7cff;
      box-shadow: 0 0 15px 3px #9d7cff;
      animation: pulse 1.7s infinite;
    }

    @keyframes pulse {
      50% {
        opacity: .35;
        transform: scale(.65);
      }
    }

    .hero h1 {
      font: 700 clamp(3.2rem,8vw,7rem)/.92 "Space Grotesk";
      letter-spacing: -.07em;
      max-width: 950px;
      margin: auto;
    }

    .gradient-text {
      background: linear-gradient(
        100deg,
        #fff 15%,
        #a78bff 48%,
        #6be7ff 82%
      );

      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .hero-description {
      max-width: 650px;
      margin: 28px auto;
      color: #aeb2c7;
      line-height: 1.7;
      font-size: 1.05rem;
    }

    .buttons {
      display: flex;
      justify-content: center;
      gap: 13px;
      flex-wrap: wrap;
    }

    .button {
      display: inline-block;
      padding: 14px 20px;
      border-radius: 15px;
      text-decoration: none;
      font-weight: 600;
      font-size: .92rem;
      transition: .25s;
    }

    .primary-button {
      color: white;
      background: linear-gradient(135deg,#7755ff,#37c8ff);
      box-shadow: 0 0 35px rgba(113,83,255,.3);
    }

    .primary-button:hover {
      transform: translateY(-4px) scale(1.02);
      box-shadow: 0 0 55px rgba(113,83,255,.55);
    }

    .secondary-button {
      color: white;
      border: 1px solid rgba(255,255,255,.13);
      background: rgba(255,255,255,.05);
    }

    .secondary-button:hover {
      background: rgba(255,255,255,.1);
      transform: translateY(-4px);
    }

    .scroll-text {
      margin-top: 55px;
      color: #777d94;
      font-size: .75rem;
      letter-spacing: 3px;
      animation: bounce 2s infinite;
    }

    @keyframes bounce {
      50% {
        transform: translateY(7px);
      }
    }

    /* ORBITS */

    .orbit {
      position: absolute;
      width: 480px;
      height: 480px;
      border: 1px solid rgba(151,111,255,.16);
      border-radius: 50%;
      animation: spin 25s linear infinite;
    }

    .orbit::before {
      content: "";
      position: absolute;
      width: 9px;
      height: 9px;
      background: #b59cff;
      border-radius: 50%;
      top: 12%;
      left: 12%;
      box-shadow: 0 0 25px 8px #8b6cff;
    }

    .orbit-two {
      width: 650px;
      height: 650px;
      border-color: rgba(0,220,255,.08);
      animation-duration: 40s;
      animation-direction: reverse;
    }

    .orbit-three {
      width: 800px;
      height: 800px;
      border-color: rgba(170,70,255,.05);
      animation-duration: 60s;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    /* SECTIONS */

    .section-title {
      text-align: center;
      margin-bottom: 45px;
    }

    .eyebrow {
      color: #9c82ff;
      text-transform: uppercase;
      letter-spacing: 3px;
      font-size: .7rem;
      font-weight: 700;
    }

    .section-title h2 {
      font: 700 clamp(2rem,5vw,3.6rem) "Space Grotesk";
      margin-top: 10px;
    }

    .section-title p {
      color: #9298ad;
      margin: 14px auto;
      max-width: 650px;
      line-height: 1.6;
    }

    /* SERVICES */

    #services {
      padding-top: 120px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(3,1fr);
      gap: 18px;
    }

    .card {
      position: relative;
      overflow: hidden;
      padding: 28px;
      border: 1px solid rgba(255,255,255,.1);
      border-radius: 24px;
      background:
        linear-gradient(
          145deg,
          rgba(255,255,255,.075),
          rgba(255,255,255,.025)
        );
      backdrop-filter: blur(14px);
      transition: .35s;
    }

    .card::before {
      content: "";
      position: absolute;
      width: 160px;
      height: 160px;
      background: #795cff;
      filter: blur(80px);
      opacity: .12;
      top: -80px;
      right: -50px;
    }

    .card:hover {
      transform: translateY(-9px);
      border-color: rgba(151,124,255,.4);
      box-shadow: 0 25px 70px rgba(0,0,0,.3);
    }

    .card-icon {
      font-size: 2rem;
      margin-bottom: 20px;
    }

    .card h3 {
      font: 600 1.3rem "Space Grotesk";
      margin-bottom: 10px;
    }

    .card p {
      color: #969bae;
      line-height: 1.6;
      font-size: .9rem;
    }

    /* PRICING */

    .pricing {
      padding-top: 150px;
    }

    .price-grid {
      display: grid;
      grid-template-columns: repeat(3,1fr);
      gap: 18px;
    }

    .price-card {
      padding: 30px;
      border: 1px solid rgba(255,255,255,.1);
      border-radius: 25px;
      background: rgba(255,255,255,.045);
      position: relative;
    }

    .price-card.featured {
      border-color: rgba(126,96,255,.55);
      box-shadow: 0 0 50px rgba(106,75,255,.12);
    }

    .tag {
      position: absolute;
      right: 18px;
      top: 18px;
      padding: 6px 9px;
      border-radius: 99px;
      background: rgba(139,92,246,.18);
      color: #c8b8ff;
      font-size: .68rem;
    }

    .price-card h3 {
      font: 600 1.3rem "Space Grotesk";
    }

    .price {
      font: 700 2.4rem "Space Grotesk";
      margin: 15px 0;
    }

    .price small {
      font: 400 .8rem Inter;
      color: #8e94a9;
    }

    .price-card p {
      color: #999fb3;
      line-height: 1.6;
      font-size: .9rem;
    }

    .price-card ul {
      list-style: none;
      margin: 22px 0;
      display: grid;
      gap: 10px;
      color: #c7cada;
      font-size: .86rem;
    }

    .price-card li::before {
      content: "✓";
      color: #8f78ff;
      margin-right: 9px;
    }

    /* ABOUT */

    .showcase {
      margin-top: 150px;
    }

    .showcase-panel {
      display: grid;
      grid-template-columns: 1.1fr .9fr;
      gap: 35px;
      align-items: center;
      padding: 45px;
      border-radius: 32px;
      border: 1px solid rgba(255,255,255,.1);
      background:
        linear-gradient(
          135deg,
          rgba(115,79,255,.12),
          rgba(0,210,255,.045),
          rgba(255,255,255,.025)
        );
    }

    .showcase-panel h2 {
      font: 700 clamp(2rem,5vw,4rem)/1 "Space Grotesk";
    }

    .showcase-panel p {
      color: #9da2b6;
      line-height: 1.7;
      margin: 20px 0;
    }

    .planet-area {
      display: grid;
      place-items: center;
      min-height: 330px;
      position: relative;
    }

    .planet {
      width: 220px;
      height: 220px;
      border-radius: 50%;
      background:
        radial-gradient(
          circle at 30% 25%,
          #d0c1ff,
          #7656e8 35%,
          #1b123d 72%
        );

      box-shadow:
        inset -30px -25px 60px rgba(0,0,0,.55),
        0 0 75px rgba(117,88,255,.35);

      position: relative;
      animation: float 5s ease-in-out infinite;
    }

    .planet::after {
      content: "";
      position: absolute;
      width: 290px;
      height: 70px;
      border: 7px solid rgba(141,126,255,.4);
      border-radius: 50%;
      transform: rotate(-18deg);
      top: 75px;
      left: -35px;
    }

    @keyframes float {
      50% {
        transform: translateY(-14px);
      }
    }

    /* CONTACT */

    .contact {
      margin: 150px auto 100px;
    }

    .contact-form {
      max-width: 700px;
      margin: auto;
      display: grid;
      gap: 13px;
    }

    input,
    textarea {
      width: 100%;
      padding: 16px 17px;
      border-radius: 15px;
      border: 1px solid rgba(255,255,255,.11);
      background: rgba(255,255,255,.045);
      color: white;
      outline: none;
      font: inherit;
      transition: .25s;
    }

    input:focus,
    textarea:focus {
      border-color: #8065ff;
      box-shadow: 0 0 25px rgba(112,83,255,.15);
    }

    textarea {
      min-height: 150px;
      resize: vertical;
    }

    .submit-button {
      border: 0;
      cursor: pointer;
      font: inherit;
      width: 100%;
    }

    .form-note {
      text-align: center;
      color: #858ba0;
      font-size: .8rem;
    }

    .email-line {
      text-align: center;
      margin-top: 18px;
      color: #aeb2c7;
      font-size: .9rem;
    }

    .email-line a {
      color: #b8a7ff;
      text-decoration: none;
    }

    .email-line a:hover {
      text-decoration: underline;
    }

    /* FOOTER */

    footer {
      border-top: 1px solid rgba(255,255,255,.08);
      padding: 30px 5%;
      color: #70768a;
      text-align: center;
      font-size: .8rem;
    }

    footer a {
      color: #9f8cff;
      text-decoration: none;
    }

    /* ANIMATION */

    .reveal {
      opacity: 0;
      transform: translateY(30px);
      transition:
        opacity .8s ease,
        transform .8s ease;
    }

    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* MOBILE */

    .mobile-menu {
      display: none;
      position: fixed;
      top: 80px;
      right: 5%;
      width: 220px;
      padding: 18px;
      background: rgba(7,9,24,.96);
      border: 1px solid rgba(255,255,255,.1);
      border-radius: 18px;
      backdrop-filter: blur(20px);
      z-index: 90;
    }

    .mobile-menu.active {
      display: flex;
      flex-direction: column;
      gap: 15px;
    }

    @media (max-width: 750px) {

      .nav-links,
      .nav-button {
        display: none;
      }

      .menu-button {
        display: block;
      }

      .cards,
      .price-grid {
        grid-template-columns: 1fr;
      }

      .showcase-panel {
        grid-template-columns: 1fr;
        padding: 28px;
      }

      .orbit {
        width: 320px;
        height: 320px;
      }

      .orbit-two {
        width: 430px;
        height: 430px;
      }

      .orbit-three {
        width: 540px;
        height: 540px;
      }

      .hero h1 {
        font-size: clamp(3rem,17vw,5rem);
      }

      .hero-description {
        font-size: .95rem;
      }

      .planet-area {
        min-height: 270px;
      }

      .planet {
        width: 180px;
        height: 180px;
      }

      .planet::after {
        width: 240px;
        left: -30px;
        top: 60px;
      }

      .pricing {
        padding-top: 110px;
      }
    }
  </style>
</head>

