<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>JSTN Co. — Beyond Ordinary</title>
  <meta
    name="description"
    content="JSTN Co. — creative digital experiences built beyond ordinary."
  />

  <style>
    @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap");

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "Inter", sans-serif;
      background: #02030a;
      color: white;
      overflow-x: hidden;
    }

    /* =========================
       SPACE BACKGROUND
    ========================= */

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -10;
      background:
        radial-gradient(
          circle at 15% 20%,
          rgba(102, 63, 255, 0.25),
          transparent 28%
        ),
        radial-gradient(
          circle at 85% 30%,
          rgba(0, 210, 255, 0.16),
          transparent 28%
        ),
        radial-gradient(
          circle at 50% 90%,
          rgba(180, 45, 255, 0.18),
          transparent 30%
        ),
        linear-gradient(
          180deg,
          #02030a 0%,
          #050719 50%,
          #02030a 100%
        );
    }

    .stars,
    .stars::before,
    .stars::after {
      position: fixed;
      inset: 0;
      content: "";
      pointer-events: none;
      z-index: -5;
    }

    .stars {
      background-image:
        radial-gradient(2px 2px at 10% 20%, white, transparent),
        radial-gradient(1px 1px at 30% 70%, white, transparent),
        radial-gradient(2px 2px at 80% 35%, white, transparent),
        radial-gradient(1px 1px at 65% 15%, white, transparent),
        radial-gradient(1px 1px at 90% 80%, white, transparent),
        radial-gradient(2px 2px at 45% 45%, white, transparent),
        radial-gradient(1px 1px at 20% 90%, white, transparent);

      background-size: 380px 380px;
      opacity: 0.65;
      animation: starMove 35s linear infinite;
    }

    .stars::before {
      background-image:
        radial-gradient(1px 1px at 20% 30%, white, transparent),
        radial-gradient(1px 1px at 70% 60%, white, transparent),
        radial-gradient(1px 1px at 40% 10%, white, transparent),
        radial-gradient(1px 1px at 95% 25%, white, transparent);

      background-size: 270px 270px;
      opacity: 0.5;
      animation: starMove 55s linear infinite reverse;
    }

    @keyframes starMove {
      from {
        transform: translate(0, 0);
      }

      to {
        transform: translate(-180px, 120px);
      }
    }

    /* =========================
       NAVBAR
    ========================= */

    .navbar {
      position: fixed;
      top: 18px;
      left: 50%;
      transform: translateX(-50%);

      width: min(1100px, 92%);

      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 13px 18px;

      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 22px;

      background: rgba(10, 12, 30, 0.58);
      backdrop-filter: blur(20px);

      box-shadow:
        0 15px 60px rgba(0, 0, 0, 0.35),
        inset 0 1px rgba(255, 255, 255, 0.05);

      z-index: 100;
    }

    .logo {
      font-family: "Space Grotesk", sans-serif;
      font-weight: 700;
      font-size: 1.2rem;
      letter-spacing: 0.5px;
    }

    .logo span {
      color: #9f7cff;
    }

    .nav-links {
      display: flex;
      gap: 25px;
    }

    .nav-links a {
      color: #c8c9d8;
      text-decoration: none;
      font-size: 0.9rem;
      transition: 0.25s;
    }

    .nav-links a:hover {
      color: white;
      text-shadow: 0 0 18px #8d6cff;
    }

    .nav-button {
      color: white;
      text-decoration: none;

      padding: 10px 15px;

      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 13px;

      background: rgba(255, 255, 255, 0.07);

      transition: 0.25s;
    }

    .nav-button:hover {
      background: rgba(255, 255, 255, 0.13);
    }

    .menu-button {
      display: none;
      cursor: pointer;
      font-size: 1.4rem;
    }

    /* =========================
       GENERAL
    ========================= */

    section {
      width: min(1120px, 90%);
      margin: auto;
    }

    /* =========================
       HERO
    ========================= */

    .hero {
      min-height: 100vh;

      display: grid;
      place-items: center;

      text-align: center;

      padding-top: 80px;

      position: relative;
      overflow: hidden;
    }

    .hero-content {
      position: relative;
      z-index: 5;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;

      padding: 8px 13px;

      border: 1px solid rgba(255, 255, 255, 0.13);
      border-radius: 999px;

      background: rgba(255, 255, 255, 0.045);

      color: #cdd0df;

      font-size: 0.8rem;

      margin-bottom: 25px;

      box-shadow: 0 0 35px rgba(113, 79, 255, 0.08);
    }

    .live-dot {
      width: 7px;
      height: 7px;

      border-radius: 50%;

      background: #9d7cff;

      box-shadow: 0 0 15px 3px #9d7cff;

      animation: pulse 1.7s infinite;
    }

    @keyframes pulse {
      50% {
        opacity: 0.35;
        transform: scale(0.65);
      }
    }

    .hero h1 {
      font-family: "Space Grotesk", sans-serif;

      font-size: clamp(3.2rem, 8vw, 7rem);

      line-height: 0.92;

      letter-spacing: -0.07em;

      max-width: 950px;

      margin: auto;
    }

    .gradient-text {
      background: linear-gradient(
        100deg,
        #ffffff 15%,
        #a78bff 48%,
        #6be7ff 82%
      );

      -webkit-background-clip: text;
      background-clip: text;

      color: transparent;
    }

    .hero-description {
      max-width: 650px;

      margin: 28px auto;

      color: #aeb2c7;

      line-height: 1.7;

      font-size: 1.05rem;
    }

    .buttons {
      display: flex;

      justify-content: center;

      gap: 13px;

      flex-wrap: wrap;
    }

    .button {
      display: inline-block;

      padding: 14px 20px;

      border-radius: 15px;

      text-decoration: none;

      font-weight: 600;

      font-size: 0.92rem;

      transition: 0.25s;
    }

    .primary-button {
      color: white;

      background: linear-gradient(
        135deg,
        #7755ff,
        #37c8ff
      );

      box-shadow:
        0 0 35px rgba(113, 83, 255, 0.3);
    }

    .primary-button:hover {
      transform: translateY(-4px) scale(1.02);

      box-shadow:
        0 0 55px rgba(113, 83, 255, 0.55);
    }

    .secondary-button {
      color: white;

      border: 1px solid rgba(255, 255, 255, 0.13);

      background: rgba(255, 255, 255, 0.05);
    }

    .secondary-button:hover {
      background: rgba(255, 255, 255, 0.1);

      transform: translateY(-4px);
    }

    .scroll-text {
      margin-top: 55px;

      color: #777d94;

      font-size: 0.75rem;

      letter-spacing: 3px;

      animation: scrollBounce 2s infinite;
    }

    @keyframes scrollBounce {
      50% {
        transform: translateY(7px);
      }
    }

    /* =========================
       ORBITS
    ========================= */

    .orbit {
      position: absolute;

      width: 480px;
      height: 480px;

      border: 1px solid rgba(151, 111, 255, 0.16);

      border-radius: 50%;

      animation: spin 25s linear infinite;
    }

    .orbit::before {
      content: "";

      position: absolute;

      width: 9px;
      height: 9px;

      background: #b59cff;

      border-radius: 50%;

      top: 12%;
      left: 12%;

      box-shadow: 0 0 25px 8px #8b6cff;
    }

    .orbit-two {
      width: 650px;
      height: 650px;

      border-color: rgba(0, 220, 255, 0.08);

      animation-duration: 40s;

      animation-direction: reverse;
    }

    .orbit-three {
      width: 800px;
      height: 800px;

      border-color: rgba(170, 70, 255, 0.05);

      animation-duration: 60s;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    /* =========================
       TITLES
    ========================= */

    .section-title {
      text-align: center;

      margin-bottom: 45px;
    }

    .eyebrow {
      color: #9c82ff;

      text-transform: uppercase;

      letter-spacing: 3px;

      font-size: 0.7rem;

      font-weight: 700;
    }

    .section-title h2 {
      font-family: "Space Grotesk", sans-serif;

      font-size: clamp(2rem, 5vw, 3.6rem);

      margin-top: 10px;
    }

    .section-title p {
      color: #9298ad;

      margin: 14px auto;

      max-width: 600px;

      line-height: 1.6;
    }

    /* =========================
       SERVICES
    ========================= */

    #services {
      padding-top: 120px;
    }

    .cards {
      display: grid;

      grid-template-columns: repeat(3, 1fr);

      gap: 18px;
    }

    .card {
      position: relative;

      overflow: hidden;

      padding: 28px;

      border: 1px solid rgba(255, 255, 255, 0.1);

      border-radius: 24px;

      background:
        linear-gradient(
          145deg,
          rgba(255, 255, 255, 0.075),
          rgba(255, 255, 255, 0.025)
        );

      backdrop-filter: blur(14px);

      transition: 0.35s;
    }

    .card::before {
      content: "";

      position: absolute;

      width: 160px;
      height: 160px;

      background: #795cff;

      filter: blur(80px);

      opacity: 0.12;

      top: -80px;
      right: -50px;
    }

    .card:hover {
      transform: translateY(-9px);

      border-color: rgba(151, 124, 255, 0.4);

      box-shadow:
        0 25px 70px rgba(0, 0, 0, 0.3);
    }

    .card-icon {
      font-size: 2rem;

      margin-bottom: 20px;
    }

    .card h3 {
      font-family: "Space Grotesk", sans-serif;

      font-size: 1.3rem;

      margin-bottom: 10px;
    }

    .card p {
      color: #969bae;

      line-height: 1.6;

      font-size: 0.9rem;
    }

    /* =========================
       ABOUT / PLANET
    ========================= */

    .showcase {
      margin-top: 150px;
    }

    .showcase-panel {
      display: grid;

      grid-template-columns: 1.1fr 0.9fr;

      gap: 35px;

      align-items: center;

      padding: 45px;

      border-radius: 32px;

      border: 1px solid rgba(255, 255, 255, 0.1);

      background:
        linear-gradient(
          135deg,
          rgba(115, 79, 255, 0.12),
          rgba(0, 210, 255, 0.045),
          rgba(255, 255, 255, 0.025)
        );

      box-shadow:
        inset 0 1px rgba(255, 255, 255, 0.05);
    }

    .showcase-panel h2 {
      font-family: "Space Grotesk", sans-serif;

      font-size: clamp(2rem, 5vw, 4rem);

      line-height: 1;
    }

    .showcase-panel p {
      color: #9da2b6;

      line-height: 1.7;

      margin: 20px 0;
    }

    .planet-area {
      display: grid;

      place-items: center;

      min-height: 330px;

      position: relative;
    }

    .planet {
      width: 220px;
      height: 220px;

      border-radius: 50%;

      background:
        radial-gradient(
          circle at 30% 25%,
          #d0c1ff,
          #7656e8 35%,
          #1b123d 72%
        );

      box-shadow:
        inset -30px -25px 60px rgba(0, 0, 0, 0.55),
        0 0 75px rgba(117, 88, 255, 0.35);

      position: relative;

      animation: floatingPlanet 5s ease-in-out infinite;
    }

    .planet::before {
      content: "";

      position: absolute;

      width: 45px;
      height: 20px;

      background: rgba(255, 255, 255, 0.1);

      border-radius: 50%;

      top: 50px;
      left: 45px;

      transform: rotate(-25deg);

      filter: blur(4px);
    }

    .planet::after {
      content: "";

      position: absolute;

      width: 290px;
      height: 70px;

      border: 7px solid rgba(141, 126, 255, 0.4);

      border-radius: 50%;

      transform: rotate(-18deg);

      top: 75px;
      left: -35px;
    }

    @keyframes floatingPlanet {
      50% {
        transform: translateY(-14px);
      }
    }

    /* =========================
       CONTACT
    ========================= */

    .contact {
      margin: 150px auto 100px;
    }

    .contact-form {
      max-width: 700px;

      margin: auto;

      display: grid;

      gap: 13px;
    }

    input,
    textarea {
      width: 100%;

      padding: 16px 17px;

      border-radius: 15px;

      border: 1px solid rgba(255, 255, 255, 0.11);

      background: rgba(255, 255, 255, 0.045);

      color: white;

      outline: none;

      font: inherit;

      transition: 0.25s;
    }

    input:focus,
    textarea:focus {
      border-color: #8065ff;

      box-shadow:
        0 0 25px rgba(112, 83, 255, 0.15);
    }

    textarea {
      min-height: 150px;

      resize: vertical;
    }

    .submit-button {
      border: none;

      cursor: pointer;

      font: inherit;
    }

    .form-note {
      text-align: center;

      color: #858ba0;

      font-size: 0.8rem;
    }

    /* =========================
       FOOTER
    ========================= */

    footer {
      border-top: 1px solid rgba(255, 255, 255, 0.08);

      padding: 30px 5%;

      color: #70768a;

      text-align: center;

      font-size: 0.8rem;
    }

    /* =========================
       ANIMATIONS
    ========================= */

    .reveal {
      opacity: 0;

      transform: translateY(30px);

      transition:
        opacity 0.8s ease,
        transform 0.8s ease;
    }

    .reveal.visible {
      opacity: 1;

      transform: translateY(0);
    }

    /* =========================
       MOBILE
    ========================= */

    @media (max-width: 750px) {
      .nav-links,
      .nav-button {
        display: none;
      }

      .menu-button {
        display: block;
      }

      .cards {
        grid-template-columns: 1fr;
      }

      .showcase-panel {
        grid-template-columns: 1fr;

        padding: 28px;
      }

      .orbit {
        width: 320px;
        height: 320px;
      }

      .orbit-two {
        width: 430px;
        height: 430px;
      }

      .orbit-three {
        width: 540px;
        height: 540px;
      }

      .hero h1 {
        font-size: clamp(3rem, 17vw, 5rem);
      }

      .hero-description {
        font-size: 0.95rem;
      }

      .planet-area {
        min-height: 270px;
      }

      .planet {
        width: 180px;
        height: 180px;
      }

      .planet::after {
        width: 240px;
        left: -30px;
        top: 60px;
      }
    }

    /* =========================
       MOBILE MENU
    ========================= */

    .mobile-menu {
      display: none;

      position: fixed;

      top: 80px;
      right: 5%;

      width: 200px;

      padding: 18px;

      background: rgba(7, 9, 24, 0.96);

      border: 1px solid rgba(255, 255, 255, 0.1);

      border-radius: 18px;

      backdrop-filter: blur(20px);

      z-index: 90;
    }

    .mobile-menu.active {
      display: flex;

      flex-direction: column;

      gap: 15px;
    }

    .mobile-menu a {
      color: white;

      text-decoration: none;

      padding: 8px;
    }
  </style>
</head>

<body>

  <!-- Animated stars -->
  <div class="stars"></div>

  <!-- NAVIGATION -->
  <nav class="navbar">

